/////////////////////////////////////////////////////////////////////////////
// English (United States) resources

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_ENU)
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAIN_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New Scenario\tCtrl+N",       ID_FILE_NEW_SCENARIO
        MENUITEM "&Open Scenario...\tCtrl+O",   ID_FILE_OPEN_SCENARIO
        MENUITEM "&Save Scenario\tCtrl+S",      ID_FILE_SAVE_SCENARIO
        MENUITEM "Save Scenario &As...",        ID_FILE_SAVE_SCENARIO_AS
        MENUITEM SEPARATOR
        MENUITEM "Open &Recording...",          ID_FILE_OPEN_RECORDING
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&Scenario"
    BEGIN
        MENUITEM "&Validate",                   ID_SCENARIO_VALIDATE
        MENUITEM "&Generate Recording",         ID_SCENARIO_GENERATE_RECORDING
        MENUITEM "&Preview",                    ID_SCENARIO_PREVIEW
        MENUITEM SEPARATOR
        MENUITEM "&Reset Scenario Clock",       ID_SCENARIO_RESET_CLOCK
    END
    POPUP "&Playback"
    BEGIN
        MENUITEM "&Start",                      ID_PLAYBACK_START
        MENUITEM "&Pause",                      ID_PLAYBACK_PAUSE
        MENUITEM "&Resume",                     ID_PLAYBACK_RESUME
        MENUITEM "S&top",                       ID_PLAYBACK_STOP
        MENUITEM SEPARATOR
        MENUITEM "&Loop",                       ID_PLAYBACK_LOOP
        POPUP "Playback &Speed"
        BEGIN
            MENUITEM "0.25x",                       ID_PLAYBACK_SPEED_025
            MENUITEM "0.5x",                        ID_PLAYBACK_SPEED_050
            MENUITEM "1x",                          ID_PLAYBACK_SPEED_1
            MENUITEM "2x",                          ID_PLAYBACK_SPEED_2
            MENUITEM "10x",                         ID_PLAYBACK_SPEED_10
        END
    END
    POPUP "&Network"
    BEGIN
        MENUITEM "&Open Network Output",        ID_NETWORK_OPEN_OUTPUT
        MENUITEM "&Close Network Output",       ID_NETWORK_CLOSE_OUTPUT
        MENUITEM SEPARATOR
        MENUITEM "Test &UDP Send",              ID_NETWORK_TEST_UDP
        MENUITEM "Test &Multicast Send",        ID_NETWORK_TEST_MULTICAST
        MENUITEM "Test &TCP Connection",        ID_NETWORK_TEST_TCP
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Validation Panel",           ID_VIEW_VALIDATION_PANEL
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About ScenarioEditor",       ID_HELP_ABOUT
        MENUITEM SEPARATOR
        MENUITEM "&Field Help Tooltips",        ID_TB_HELP_TOGGLE
        MENUITEM SEPARATOR
        MENUITEM "&Protocol Notes",             ID_HELP_PROTOCOL_NOTES
        MENUITEM "&File Format Notes",          ID_HELP_FILE_FORMAT_NOTES
    END
END



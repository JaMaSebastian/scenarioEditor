IDR_MAIN_ACCEL ACCELERATORS
BEGIN
    "N",            ID_FILE_NEW_SCENARIO,   VIRTKEY, CONTROL
    "O",            ID_FILE_OPEN_SCENARIO,  VIRTKEY, CONTROL
    "S",            ID_FILE_SAVE_SCENARIO,  VIRTKEY, CONTROL
    "A",            ID_KB_ADD_ASSET,        VIRTKEY, CONTROL, ALT
    "D",            ID_KB_DELETE_ASSET,     VIRTKEY, CONTROL, ALT
    "U",            ID_KB_DUPLICATE_ASSET,  VIRTKEY, CONTROL, ALT
    "M",            ID_KB_MOVE_ASSET,       VIRTKEY, CONTROL, ALT
    "S",            ID_KB_ADD_SEGMENT,      VIRTKEY, CONTROL, ALT
    "X",            ID_KB_DELETE_SEGMENT,   VIRTKEY, CONTROL, ALT
    "P",            ID_KB_DUPLICATE_SEGMENT, VIRTKEY, CONTROL, ALT
END


